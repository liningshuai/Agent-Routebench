{
  "name": "agent-workbench-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Independent local-first Desktop + CLI coding agent workbench",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:focused": "vitest run --dir tests",
    "security:scan": "node scripts/security-scan.mjs",
    "evals:deterministic": "node scripts/evals-deterministic.mjs",
    "verify:layout": "node scripts/verify-layout.mjs",
    "build:cli": "pnpm --filter @agent-workbench/cli build",
    "build:desktop": "pnpm --filter @agent-workbench/desktop build",
    "cli": "pnpm --filter @agent-workbench/cli start"
  },
  "devDependencies": {
    "@agent-workbench/agent-contracts": "workspace:*",
    "@agent-workbench/agent-core": "workspace:*",
    "@agent-workbench/agent-memory": "workspace:*",
    "@agent-workbench/agent-runtime": "workspace:*",
    "@agent-workbench/local-agent-api": "workspace:*",
    "@agent-workbench/local-persistence": "workspace:*",
    "@agent-workbench/model-gateway": "workspace:*",
    "@agent-workbench/provider-discovery": "workspace:*",
    "@agent-workbench/provider-registry": "workspace:*",
    "@agent-workbench/session-persistence": "workspace:*",
    "@types/node": "^24.10.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
